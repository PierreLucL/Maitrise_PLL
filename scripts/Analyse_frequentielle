### Importations ###
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from pathlib import Path
from maitrise_curbd.timeseries import (
    smooth_timeseries,
    compute_mean_psd,
    compute_mean_autocorrelation,
    estimate_autocorrelation_timescale,
)
import h5py
import matplotlib.pyplot as plt
import numpy as np
from matplotlib.colors import to_rgb
from matplotlib.gridspec import GridSpec
from pathlib import Path

from maitrise_curbd.io import load_dataset
from maitrise_curbd.masks import (remove_thin_label_artifacts,
    reduce_atlas_to_6_regions,subdivide_mask_by_spatial_clustering, 
    build_parent_regions_dict)

from maitrise_curbd.timeseries import (
    smooth_timeseries,compute_cumulative_power_frequencies,
    compute_mean_psd,
    compute_mean_autocorrelation,
    estimate_autocorrelation_timescale,
    extract_timeseries_du_tenseur, compute_dff, regress_out_global_signal
)

from maitrise_curbd.curbd import computeCURBD, trainMultiRegionRNN
from maitrise_curbd.plotting import gradient_line, plot_10_ts_with_mask_and_similarity

# =============================================================================
# Cohortes disponibles
#
# C0 : M10[253] | M12[191,210,213,233] | M20[42,253]
# C2 : M6-16[308] | M20[304]
# C3 : M6-14[316,322] | M16-20[316]
# C5 : M6[353,361] | M8-14[353] | M18-20[359]
# C6 : M6[365,367,374] | M8-18[374]
# C7 : M6[387,396,397] | M10-12[387]
# C8 : M6[409] | M18-20[408]
# C9 : M6[410,415] | M8[410,412,415] | M10-12[410,412]
#      M14-16[410] | M18-20[415]
# =============================================================================

#########################################################################################################
# SETUP
##########################################################################################################

n_cohorte = 3
month = 16
souris = 316
n_pixels = 50
lissage_sigma = 4
Combien_de_petites_regions = 5
nRunTrain = 500
debug = True
plot = True

#########################################################################################################
# Preworkout
##########################################################################################################

### On sort les données
gcamp, atlas, roi_mask = load_dataset(
    cohort=n_cohorte,
    month=month,
    mouse=souris)

print("GCaMP :", gcamp.shape, gcamp.dtype)
print("Atlas :", atlas.shape, atlas.dtype)
print("ROI mask :", roi_mask.shape, roi_mask.dtype)

### On clean le masque, on extrait les pixels actifs, on retire les pixels morts du masque, et on subdivise le masque
clean_atlas = remove_thin_label_artifacts(atlas,size=5,min_fraction=0.25)

atlas_6 = reduce_atlas_to_6_regions(
    atlas=clean_atlas,
    roi_mask=roi_mask,
)
masque_sub, info_masque_sub = subdivide_mask_by_spatial_clustering(atlas_6, target_size=n_pixels)


### Building du dictionnaire de régions parentes
regions = build_parent_regions_dict(info_masque_sub)

# À la chasse aux petites régions
n_regions = len(np.unique(masque_sub[~np.isnan(masque_sub)]))
tailles_regions = sorted(((np.sum(masque_sub == l), l) for l in np.unique(masque_sub) if not np.isnan(l)),key=lambda x: x[0])

print('Il y a un total de {} sous-régions'.format(n_regions))
print(f"Les tailles respectives en pixels des {Combien_de_petites_regions} plus petites régions sont "+ ", ".join(
        str(int(taille))
        for taille, _ in tailles_regions[:Combien_de_petites_regions]))

### Get these TS
ts = extract_timeseries_du_tenseur(gcamp, masque_sub)


#########################################################################################################
# Opérations sur les TS
##########################################################################################################

# Extraction
ts = extract_timeseries_du_tenseur(
    gcamp,
    masque_sub
)

# ΔF/F
ts = compute_dff(
    ts,
    fs=12,
    window_sec=60,
    percentile=8
)

# Régression globale
ts = regress_out_global_signal(
    ts
)

# Lissage EN DERNIER
timeseries = smooth_timeseries(
    ts,
    sigma=lissage_sigma
)

### Z-score
#ts = (ts - ts.mean(axis=1, keepdims=True)) / ts.std(axis=1, keepdims=True)



# ============================================================
# Analyse temporelle du lissage
# ============================================================

sigma_list = [0, 2, 4, 6, 8]

dtData = 1 / 12
fs = 1 / dtData

max_lag_seconds = 5.0

output_dir = Path(
    "results/temporal_analysis"
)

output_dir.mkdir(
    parents=True,
    exist_ok=True
)


# ============================================================
# Stockage des résultats
# ============================================================

psd_results = {}
acf_results = {}

summary_rows = []


# ============================================================
# Boucle sur sigma
# ============================================================

for sigma in sigma_list:

    print(
        f"\n========== sigma = {sigma} =========="
    )

    # --------------------------------------------------------
    # Lissage
    # --------------------------------------------------------

    if sigma == 0:
        ts_smooth = timeseries.copy()

    else:
        ts_smooth = smooth_timeseries(
            timeseries,
            sigma=sigma
        )


    # --------------------------------------------------------
    # PSD
    # --------------------------------------------------------

    freqs, mean_psd, psd_all = compute_mean_psd(
        ts_smooth,
        fs=fs
    )

    power_freqs, cumulative_fraction = (
    compute_cumulative_power_frequencies(
        freqs,
        mean_psd
    )
    )

    f50 = power_freqs["f50"]
    f90 = power_freqs["f90"]
    f95 = power_freqs["f95"]
    f99 = power_freqs["f99"]

    psd_results[sigma] = {
        "freqs": freqs,
        "mean_psd": mean_psd,
        "psd_all": psd_all,
    }


    # --------------------------------------------------------
    # Autocorrélation
    # --------------------------------------------------------

    lag_times, mean_acf, acf_all = (
        compute_mean_autocorrelation(
            ts_smooth,
            dt=dtData,
            max_lag_seconds=max_lag_seconds
        )
    )

    tau_acf = estimate_autocorrelation_timescale(
        lag_times,
        mean_acf
    )

    acf_results[sigma] = {
        "lag_times": lag_times,
        "mean_acf": mean_acf,
        "acf_all": acf_all,
        "tau_acf": tau_acf,
    }


    # --------------------------------------------------------
    # Quantifier combien de puissance demeure à haute fréquence
    # --------------------------------------------------------

    total_power = np.trapezoid(
    mean_psd,
    freqs
    )   

    power_above_1hz = np.trapezoid(
        mean_psd[freqs >= 1],
        freqs[freqs >= 1]
    )

    fraction_above_1hz = (
        power_above_1hz / total_power
        if total_power > 0
        else np.nan
    )


    # --------------------------------------------------------
    # Largeur temporelle du filtre
    # --------------------------------------------------------

    sigma_seconds = sigma * dtData

    fwhm_seconds = (
        2.355 * sigma_seconds
    )


    # --------------------------------------------------------
    # Tableau résumé
    # --------------------------------------------------------

    summary_rows.append({
        "sigma_frames": sigma,
        "sigma_seconds": sigma_seconds,
        "FWHM_seconds": fwhm_seconds,
        "tau_acf_seconds": tau_acf,
        "fraction_power_above_1Hz": fraction_above_1hz,
        "f50_Hz": f50,
        "f90_Hz": f90,
        "f95_Hz": f95,
        "f99_Hz": f99,
    })


    print(
        f"tau ACF = {tau_acf:.3f} s"
    )

    print(
        f"Puissance > 1 Hz = "
        f"{100 * fraction_above_1hz:.2f} %"
    )


# ============================================================
# DataFrame résumé
# ============================================================

summary_df = pd.DataFrame(
    summary_rows
)

print("\n")
print(summary_df)

summary_df.to_csv(
    output_dir / "temporal_smoothing_summary.csv",
    index=False
)

# ============================================================
# FIGURE 1 : PSD
# ============================================================

plt.figure(
    figsize=(8, 5)
)

for sigma in sigma_list:

    freqs = psd_results[sigma]["freqs"]
    mean_psd = psd_results[sigma]["mean_psd"]

    plt.plot(
        freqs,
        mean_psd,
        label=f"sigma={sigma}"
    )

plt.yscale("log")

plt.xlim(
    0,
    fs / 2
)

plt.xlabel(
    "Fréquence (Hz)"
)

plt.ylabel(
    "Densité spectrale de puissance"
)

plt.title(
    "Effet du lissage sur le contenu fréquentiel"
)

plt.legend()

plt.tight_layout()

plt.savefig(
    output_dir / "PSD_vs_sigma.png",
    dpi=300
)

plt.show()

# ============================================================
# FIGURE 2 : AUTOCORRÉLATION
# ============================================================

plt.figure(
    figsize=(8, 5)
)

for sigma in sigma_list:

    lag_times = (
        acf_results[sigma]["lag_times"]
    )

    mean_acf = (
        acf_results[sigma]["mean_acf"]
    )

    tau_acf = (
        acf_results[sigma]["tau_acf"]
    )

    plt.plot(
        lag_times,
        mean_acf,
        label=(
            f"sigma={sigma}, "
            f"tau={tau_acf:.2f}s"
        )
    )


plt.axhline(
    np.exp(-1),
    linestyle="--",
    alpha=0.5,
    label="1/e"
)

plt.xlabel(
    "Décalage temporel (s)"
)

plt.ylabel(
    "Autocorrélation"
)

plt.title(
    "Effet du lissage sur l'échelle temporelle"
)

plt.legend()

plt.tight_layout()

plt.savefig(
    output_dir / "autocorrelation_vs_sigma.png",
    dpi=300
)

plt.show()

plt.figure(figsize=(8, 5))

for sigma in sigma_list:

    freqs = psd_results[sigma]["freqs"]
    mean_psd = psd_results[sigma]["mean_psd"]

    power_freqs, cumulative_fraction = (
        compute_cumulative_power_frequencies(
            freqs,
            mean_psd
        )
    )

    plt.plot(
        freqs,
        cumulative_fraction,
        label=f"sigma={sigma}"
    )

plt.axhline(
    0.50,
    linestyle="--",
    alpha=0.5
)

plt.axhline(
    0.90,
    linestyle="--",
    alpha=0.5
)

plt.axhline(
    0.95,
    linestyle="--",
    alpha=0.5
)

plt.axhline(
    0.99,
    linestyle="--",
    alpha=0.5
)

plt.xlabel("Fréquence (Hz)")
plt.ylabel("Fraction cumulée de puissance")
plt.title("Distribution cumulative de la puissance spectrale")

plt.xlim(0, 2)

plt.legend()
plt.tight_layout()
plt.show()